# freebuff-proxy 一键部署环境变量模板（可选）
# 复制为 .env 后按需修改：cp .env.example .env
# 不建 .env 时全部使用默认值，无需任何配置即可启动。

# 对外暴露端口（默认 8787）
PORT=8787

# 首次启动的管理员（默认 admin）
ADMIN_USERNAME=admin
# 强烈建议设置固定密码；留空则随机生成，首次启动打印在 docker compose logs 里
ADMIN_PASSWORD=

# 上游代理（可选）。推荐直接在 /data/config.yaml 的 upstream.proxies 里配置，
# 代理在另一台机器时填真实 IP，在本机且监听 0.0.0.0 时也可用 host.docker.internal / 网关 IP
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,172.16.0.0/12

# 时区
TZ=Asia/Shanghai
