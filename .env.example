# freebuff-proxy 一键部署环境变量
# 复制为 .env 后按需修改：cp .env.example .env

# 对外暴露端口（仅 NETWORK_MODE=bridge 时生效；host 模式服务直接监听 0.0.0.0:8787）
PORT=8787

# 网络模式：host（默认，推荐 VPS 单机）| bridge
# host = 容器与宿主机共享网络，代理在本机时配置里直接写 http://127.0.0.1:<端口>
NETWORK_MODE=host

# 首次启动的管理员（默认 admin）
ADMIN_USERNAME=admin
# 强烈建议设置固定密码；留空则随机生成，首次启动打印在 docker compose logs 里
ADMIN_PASSWORD=

# 上游代理（可选）。例：socks5://127.0.0.1:1080 或 http://user:pass@127.0.0.1:7890
# 也可以不改这里，直接在 /data/config.yaml 里配 upstream.proxy
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,172.16.0.0/12

# 时区
TZ=Asia/Shanghai
