{
  "name": "freebuff-proxy",
  "version": "1.26.4",
  "private": true,
  "description": "OpenAI-compatible reverse proxy that handles Freebuff auth and free-session admission",
  "repository": {
    "type": "git",
    "url": "https://github.com/HengXin666/freebuff-proxy.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/serve.js",
    "serve": "node bin/serve.js",
    "login": "node bin/login.js",
    "doctor": "node bin/doctor.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/smoke.mjs && node test/smoke-frontend.mjs && node test/verify-model-name-chain.mjs && node test/verify-catalog-models.mjs && node test/verify-model-mapping-truth.mjs && node test/verify-tool-name-mapping.mjs",
    "pipeline:image": "node scripts/ci/pipeline-image-test.mjs",
    "web": "node bin/serve.js",
    "pricing": "node bin/pricing.js",
    "verify-notes": "node .agents/skills/hx-agent-notes/scripts/verify-all.ts",
    "verify-notes:staged": "node .agents/skills/hx-agent-notes/scripts/verify-all.ts --staged",
    "verify-notes:tree": "node .agents/skills/hx-agent-notes/scripts/verify-tree.ts",
    "verify-notes:format": "node .agents/skills/hx-agent-notes/scripts/verify-format.ts",
    "verify-notes:coverage": "node .agents/skills/hx-agent-notes/scripts/verify-coverage.ts",
    "verify-notes:backlinks": "node .agents/skills/hx-agent-notes/scripts/verify-backlinks.ts",
    "notes:new": "node .agents/skills/hx-agent-notes/scripts/new-note.ts",
    "notes:archive": "node .agents/skills/hx-agent-notes/scripts/archive-note.ts",
    "notes:board": "node .agents/skills/hx-agent-notes/scripts/build-board.ts --init board.html",
    "test:smoke": "node test/smoke.mjs",
    "test:catalog": "node test/verify-catalog-models.mjs",
    "gen:contract": "node scripts/catalog/gen-upstream-contract.mjs",
    "check:contract": "node scripts/check-upstream-contract.mjs",
    "check:all": "npm run check:gates && npm run check:contract && npm run test:catalog && npm run typecheck && npm run test:smoke",
    "check:gates": "node scripts/gates/run.mjs",
    "check:gates:commit": "node scripts/gates/run.mjs pre-commit",
    "check:gates:push": "node scripts/gates/run.mjs pre-push",
    "check:gates:fingerprint": "node scripts/gates/meta/fingerprint.mjs",
    "check:gates:fingerprint:update": "node scripts/gates/meta/fingerprint.mjs --update",
    "check:gates:probe": "node scripts/gates/probe-gates.mjs"
  },
  "dependencies": {
    "undici": "^8.10.2",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
