{
  "name": "freebuff-proxy",
  "version": "1.15.0",
  "private": true,
  "description": "OpenAI-compatible reverse proxy that handles Freebuff auth and free-session admission",
  "repository": {
    "type": "git",
    "url": "https://github.com/HengXin666/freebuff-proxy.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/serve.js",
    "serve": "node bin/serve.js",
    "login": "node bin/login.js",
    "doctor": "node bin/doctor.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/smoke.mjs",
    "pipeline:image": "node scripts/pipeline-image-test.mjs",
    "web": "node bin/serve.js",
    "pricing": "node bin/pricing.js",
    "verify-notes": "node .agents/skills/hx-agent-notes/scripts/verify-all.ts",
    "verify-notes:staged": "node .agents/skills/hx-agent-notes/scripts/verify-all.ts --staged",
    "verify-notes:tree": "node .agents/skills/hx-agent-notes/scripts/verify-tree.ts",
    "verify-notes:format": "node .agents/skills/hx-agent-notes/scripts/verify-format.ts",
    "verify-notes:coverage": "node .agents/skills/hx-agent-notes/scripts/verify-coverage.ts",
    "verify-notes:backlinks": "node .agents/skills/hx-agent-notes/scripts/verify-backlinks.ts",
    "notes:new": "node .agents/skills/hx-agent-notes/scripts/new-note.ts",
    "notes:archive": "node .agents/skills/hx-agent-notes/scripts/archive-note.ts",
    "notes:board": "node .agents/skills/hx-agent-notes/scripts/build-board.ts --init board.html"
  },
  "dependencies": {
    "undici": "^8.10.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
